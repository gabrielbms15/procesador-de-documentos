# ==============================================================================
# PROCESADOR DE DOCUMENTOS - .gitignore
# Frontend (Next.js / pnpm) & Backend (Python / FastAPI)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND: Next.js, Node.js & pnpm
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next/
out/
build/
dist/

# TypeScript cache
*.tsbuildinfo

# Next.js telemetry / bundle analysis
.vercel

# ------------------------------------------------------------------------------
# 2. BACKEND: Python & FastAPI
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments (venv, poetry, pipenv, conda)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# FastAPI / Uvicorn temporary & upload folders
uploads/
temp/
temp_uploads/
exports/
input/
backend/input/
*.xlsx
*.csv

# SQLite & local databases
*.sqlite
*.sqlite3
*.db

# Testing & Coverage (pytest, mypy, ruff)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml

# Distribution / packaging
develop-eggs/
.eggs/
*.egg-info/
*.egg

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT VARIABLES & SECRETS (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# ------------------------------------------------------------------------------
# 4. OS & IDE ARTIFACTS
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
