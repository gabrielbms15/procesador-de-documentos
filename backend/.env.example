# ==============================================================================
# CONFIGURACIÓN DEL BACKEND (FastAPI + LangGraph)
# Copia este archivo como .env en esta misma carpeta (backend/.env)
# ==============================================================================

# Clave de OpenAI (Obligatoria para Pólizas y DNI, debe iniciar con sk-)
OPENAI_API_KEY=sk-tu-api-key-de-openai-aqui

# Configuración del modelo (Opcional, por defecto gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Logging
LOG_LEVEL=INFO
